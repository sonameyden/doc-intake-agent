# Copy to .env (never commit .env).

# Development: free Gemini API key from Google AI Studio (synthetic data only).
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=

# Deployment: Gemini on Vertex AI (Google Cloud project with the trial credit).
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# gemini-2.5-flash is deprecated for new users (Nov 2026). Try gemini-4-hydrogen to compare.
MODEL=gemini-3.5-flash-lite

# Where the agent's tools reach the mock ERP.
ERP_URL=http://127.0.0.1:8001

# USD per million tokens for the model above, from the current pricing page.
PRICE_INPUT_PER_M=
PRICE_OUTPUT_PER_M=
